{
  "name": "af-irs-ape",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "ready": "vp run -r build && vp check && vp run -r test",
    "dev": "vp run -r --parallel dev",
    "dev:web": "vp run web#dev",
    "dev:api": "vp run api#dev",
    "start:prod": "vp run api#start:prod",
    "build": "vp run -r build",
    "test": "vp run -r test",
    "prepare": "vp config"
  },
  "devDependencies": {
    "vite-plus": "1.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.2.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
